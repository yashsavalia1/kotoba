{
  "name": "kotoba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Migaku-style sentence mining for your own media files.",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --no-warnings server/index.mjs",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "npm run build && node --no-warnings server/index.mjs",
    "dict": "node --no-warnings --max-old-space-size=6144 scripts/build-dict.mjs",
    "test": "node --no-warnings --test test/*.test.mjs",
    "e2e": "node --no-warnings scripts/e2e.mjs",
    "mock-anki": "node --no-warnings scripts/mock-anki.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "express": "^4.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
