{
  "name": "kotoba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sentence mining for your own media: a desktop player with hover dictionary and Anki cards.",
  "scripts": {
    "dev": "concurrently -k -n web,app -c magenta,cyan \"vite --config vite.config.mjs\" \"KOTOBA_RENDERER_URL=http://localhost:${KOTOBA_VITE_PORT:-5173} electron .\"",
    "build": "vite build --config vite.config.mjs",
    "start": "npm run build && electron .",
    "dict": "node --no-warnings --max-old-space-size=6144 scripts/build-dict.mjs",
    "test": "node --no-warnings --test test/*.test.mjs",
    "shot": "node scripts/shot.mjs",
    "mock-anki": "node --no-warnings scripts/mock-anki.mjs",
    "pack-dict": "node --no-warnings scripts/pack-dict.mjs",
    "dist": "node build/fetch-ffprobe.mjs && npm run build && npm run pack-dict && electron-builder --mac --arm64",
    "e2e": "playwright test --project=dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "ffmpeg-static": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "src/main/main.mjs",
  "build": {
    "appId": "com.yashs.kotoba",
    "productName": "Kotoba",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/renderer/**",
      "out/renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg"
    ],
    "extraResources": [
      {
        "from": "build/dict.db",
        "to": "dict.db"
      },
      {
        "from": "build/ffprobe-darwin-arm64/ffprobe",
        "to": "bin/ffprobe"
      }
    ],
    "fileAssociations": [
      {
        "name": "Media",
        "ext": [
          "mkv",
          "mp4",
          "m4v",
          "webm",
          "mov",
          "mp3",
          "flac",
          "m4a",
          "aac",
          "ogg",
          "oga",
          "opus",
          "wav",
          "mka"
        ],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Subtitles",
        "ext": [
          "srt",
          "vtt",
          "ass",
          "ssa"
        ],
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Kotoba"
    },
    "electronLanguages": [
      "en",
      "ja"
    ]
  }
}
